# ============================================================
# GitPreserver Configuration
# ============================================================
# Copy this file to .env (in the project root) and fill in
# your values. Never commit .env to version control.
#
# Environment variables always override config file values.
# See docs/configuration.md for the full reference.
# ============================================================

# ------------------------------------------------------------
# Git Host — required
# ------------------------------------------------------------

# Personal Access Token
#
# GitHub — fine-grained PAT (recommended, starts with `github_pat_`):
#   Settings → Developer settings → Personal access tokens → Fine-grained tokens
#   Repository access:  All repositories (or select the repos you want backed up)
#   Repository permissions (read-only):
#     Contents:       Read   (clone)
#     Metadata:       Read   (mandatory; auto-selected)
#     Issues:         Read   (issue export)
#     Pull requests:  Read   (PR export)
#   For organization repos owned by an org that requires PAT approval:
#     - The org must allow fine-grained PATs (Org settings → Personal access tokens)
#     - Add Organization permissions → Members: Read
#
# GitHub — classic PAT (legacy, starts with `ghp_`):
#   Settings → Developer settings → Personal access tokens → Tokens (classic)
#   Scopes: repo (full), read:user. Add read:org for organization repos.
#
# Bitbucket: App Password with Repositories: Read scope
# GitLab:    Personal Access Token with read_repository scope
# Gitea:     User Settings → Applications → Access Token
GITPRESERVER_TOKEN=

# Username or organization name to back up
GITPRESERVER_USERNAME=

# Git host type: github | bitbucket | gitlab | gitea (default: github)
GITPRESERVER_HOST_TYPE=github

# Custom host URL — required for self-hosted GitLab, Gitea, Forgejo, etc.
# Leave blank for github.com, bitbucket.org, gitlab.com
# Example: https://gitlab.mycompany.com
GITPRESERVER_HOST_URL=

# ------------------------------------------------------------
# Backup Storage
# ------------------------------------------------------------

# Host path that will be bind-mounted into the container at /backups.
# Use an absolute path for production (e.g. /opt/gitpreserver/backups,
# /volume1/gitpreserver-backups on Synology, /mnt/user/appdata/gitpreserver
# on unRAID). Defaults to ./backups relative to the repo root.
GITPRESERVER_HOST_BACKUP_DIR=./backups

# In-container backup path used by the scripts. The host directory above
# is mounted here. Most users should NOT change this — it's exposed only
# for advanced setups that remap the mount point.
GITPRESERVER_BACKUP_DIR=/backups

# Days to retain local backup snapshots before pruning.
# Set to 0 to disable pruning (keep all snapshots forever).
GITPRESERVER_RETENTION_DAYS=30

# ------------------------------------------------------------
# Remote Sync (rclone)
# ------------------------------------------------------------

# Name of the rclone remote to sync to.
# This remote must be configured in rclone/rclone.conf.
# Examples: b2-remote, s3-remote, gdrive, onedrive, mega, smb-nas
# Leave blank to skip remote sync (local backup only).
GITPRESERVER_RCLONE_REMOTE=

# Path or bucket on the remote to sync into.
GITPRESERVER_RCLONE_PATH=gitpreserver-backups

# Full path to rclone config file on the host.
# Default: ./rclone/rclone.conf (mounted read-only by docker-compose).
GITPRESERVER_RCLONE_CONFIG=

# Number of parallel file transfers (default: 4).
GITPRESERVER_RCLONE_TRANSFERS=4

# ------------------------------------------------------------
# Encryption (rclone crypt)
# ------------------------------------------------------------

# Set to true to encrypt backups at rest on the remote.
# Requires a crypt remote configured in rclone.conf.
# See docs/encryption.md for setup instructions.
GITPRESERVER_ENCRYPT=false

# Name of the rclone crypt remote (wraps GITPRESERVER_RCLONE_REMOTE).
# Must be configured in rclone.conf as type = crypt.
GITPRESERVER_CRYPT_REMOTE=

# Encryption passphrase.
# Generate a strong one: openssl rand -base64 32
# Store it in Bitwarden — without it your backup is permanently unrecoverable.
GITPRESERVER_CRYPT_PASS=

# Salt for password obfuscation (rclone obscure your-passphrase).
# Recommended: hardens against brute force.
# Generate: rclone obscure your-salt-passphrase
GITPRESERVER_CRYPT_PASS2=

# Path to a keyfile for encryption (alternative or supplement to passphrase).
# The keyfile must be mounted into the container if used.
GITPRESERVER_CRYPT_KEYFILE=

# ------------------------------------------------------------
# Run Mode
# ------------------------------------------------------------

# oneshot: run backup once and exit (default — use with external cron,
#          Synology Task Scheduler, unRAID User Scripts, or CI).
# daemon:  stay running; fire backup on GITPRESERVER_SCHEDULE and serve
#          the web UI on GITPRESERVER_WEB_PORT.
GITPRESERVER_MODE=oneshot

# Cron expression for scheduled runs (daemon mode) or documentation
# purposes when scheduling externally. Default: every Sunday at 2:00 AM.
GITPRESERVER_SCHEDULE=0 2 * * 0

# Web UI port (daemon mode only). Default: 6033.
GITPRESERVER_WEB_PORT=6033

# ------------------------------------------------------------
# rclone via environment variables (no rclone.conf required)
# ------------------------------------------------------------
# rclone reads RCLONE_CONFIG_<REMOTE>_<KEY>=value for any remote.
# Remote names are uppercased; hyphens become underscores in the var name.
# When using this approach, leave GITPRESERVER_RCLONE_CONFIG blank.
#
# Example — Backblaze B2 backend + crypt encryption layer:
#
# RCLONE_CONFIG_B2_TYPE=b2
# RCLONE_CONFIG_B2_ACCOUNT=your_account_id
# RCLONE_CONFIG_B2_KEY=your_app_key
#
# RCLONE_CONFIG_MYCRYPT_TYPE=crypt
# RCLONE_CONFIG_MYCRYPT_REMOTE=b2:gitpreserver-backups
# RCLONE_CONFIG_MYCRYPT_FILENAME_ENCRYPTION=standard
# RCLONE_CONFIG_MYCRYPT_DIRECTORY_NAME_ENCRYPTION=true
# RCLONE_CONFIG_MYCRYPT_PASSWORD=<output of: rclone obscure 'your-passphrase'>
# RCLONE_CONFIG_MYCRYPT_PASSWORD2=<output of: rclone obscure 'your-salt'>
#
# Then set:
# GITPRESERVER_RCLONE_REMOTE=b2
# GITPRESERVER_ENCRYPT=true
# GITPRESERVER_CRYPT_REMOTE=mycrypt

# ------------------------------------------------------------
# Notifications (roadmap — not yet implemented)
# ------------------------------------------------------------

# Webhook URL for backup completion and failure notifications.
# Supports Slack, Discord, ntfy, and generic webhooks.
GITPRESERVER_WEBHOOK_URL=

# ------------------------------------------------------------
# Advanced
# ------------------------------------------------------------

# Path to an optional config file.
# Env vars always take precedence over config file values.
# See config/gitpreserver.conf.example for the format.
GITPRESERVER_CONFIG=

# Log level: debug | info | warn | error (default: info)
GITPRESERVER_LOG_LEVEL=info

# Set to true to perform a dry run (no writes, no sync, no deletions).
GITPRESERVER_DRY_RUN=false
