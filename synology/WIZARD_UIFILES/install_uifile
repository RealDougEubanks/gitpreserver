      },
      {
        "type": "password",
        "desc": "Personal Access Token (requires repo and read:user scopes on GitHub)",
        "subitems": [
          {
            "key": "pkgwizard_token",
            "desc": "Token",
            "defaultValue": ""
          }
        ]
      }
    ]
  },
  {
    "step_title": "Backup Location",
    "items": [
      {
        "type": "textfield",
        "desc": "Local path on the NAS where backups will be stored",
        "subitems": [
          {
            "key": "pkgwizard_backup_dir",
            "desc": "Backup path",
            "defaultValue": "/volume1/gitpreserver-backups"
          }
        ]
      }
    ]
  },
  {
    "step_title": "Schedule",
    "items": [
      {
        "type": "singleselect",
        "desc": "How often should GitPreserver run?",
        "subitems": [
          {
            "key": "pkgwizard_schedule",
            "displayText": "Weekly (Sunday at 2 AM)",
            "defaultValue": "0 2 * * 0"
          },
          {
            "key": "pkgwizard_schedule",
            "displayText": "Daily at 2 AM",
            "defaultValue": "0 2 * * *"
          },
          {
            "key": "pkgwizard_schedule",
            "displayText": "Manual only",
            "defaultValue": ""
          }
        ]
      }
    ]
  },
