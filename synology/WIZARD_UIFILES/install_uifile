      {
        "type": "singleselect",
        "desc": "Which git hosting service do you want to back up?",
        "subitems": [
          {
            "key": "pkgwizard_host_type",
            "displayText": "GitHub",
            "defaultValue": "github"
          },
          {
            "key": "pkgwizard_host_type",
            "displayText": "Bitbucket",
            "defaultValue": "bitbucket"
          },
          {
            "key": "pkgwizard_host_type",
            "displayText": "GitLab",
            "defaultValue": "gitlab"
          },
          {
            "key": "pkgwizard_host_type",
            "displayText": "Gitea / Self-hosted",
            "defaultValue": "gitea"
          }
        ]
      },
      {
        "type": "textfield",
        "desc": "Username or organization name to back up",
        "subitems": [
          {
            "key": "pkgwizard_username",
            "desc": "Username or org",
            "defaultValue": "",
            "emptyText": "e.g. myusername"
